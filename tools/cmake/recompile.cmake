# The game's code recompiled at configure time: XenonRecomp (tools/XenonRecomp) is built with this build's compiler and
# run on default.xex (the repository's top folder) with GracemeriaRecompLib/config/AC6.toml, writing
# GracemeriaRecompLib/ppc. It runs again when default.xex, the config, the switch tables or XenonRecomp's sources change
# (a hash of them in ppc/ac6_recomp.key). An existing ppc without the key is kept as it is. AC6_RECOMPILE=OFF: never.
option(AC6_RECOMPILE "Recompile the game's code from default.xex at configure time when it is missing or out of date" ON)

set(AC6_PPC "${AC6_LIB_ROOT}/ppc")
set(AC6_XEX "${CMAKE_SOURCE_DIR}/default.xex")
file(GLOB AC6_RECOMPILER_SOURCES "${AC6_XENON}/XenonRecomp/*.cpp" "${AC6_XENON}/XenonRecomp/*.h")
list(SORT AC6_RECOMPILER_SOURCES)
set(AC6_RECOMP_INPUTS "${AC6_XEX}" "${AC6_LIB_ROOT}/config/AC6.toml" "${AC6_LIB_ROOT}/config/AC6_switch_tables.toml"
    ${AC6_RECOMPILER_SOURCES})
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${AC6_RECOMP_INPUTS})

function(ac6_recompile)
    set(key "")
    foreach (f ${AC6_RECOMP_INPUTS})
        if (NOT EXISTS "${f}")
            if (f STREQUAL AC6_XEX AND NOT EXISTS "${AC6_PPC}/ppc_recomp_shared.h")
                message(FATAL_ERROR "No default.xex: put the game's default.xex (from your disc image) in ${CMAKE_SOURCE_DIR}")
            endif()
            return()   # (the code is there, no xex to check it against)
        endif()
        # (Text files without their line endings: a checkout's CRLF must not count as a change.)
        if (f MATCHES "\\.(toml|cpp|h)$")
            file(READ "${f}" text)
            string(REPLACE "\r\n" "\n" text "${text}")
            string(SHA256 h "${text}")
        else()
            file(SHA256 "${f}" h)
        endif()
        string(APPEND key "${h}\n")
    endforeach()
    string(SHA256 key "${key}")
    set(keyFile "${AC6_PPC}/ac6_recomp.key")
    if (EXISTS "${AC6_PPC}/ppc_recomp_shared.h")
        if (NOT EXISTS "${keyFile}")
            file(WRITE "${keyFile}" "${key}")   # no key yet: kept, and the key written
            return()
        endif()
        file(READ "${keyFile}" old)
        if (old STREQUAL key)
            return()
        endif()
    endif()

    # XenonRecomp, built once into its own build folder with this build's compiler. (fmt 11 in its submodules uses
    # malloc / free without <cstdlib>, which libc++ doesn't pull in for it.)
    set(xr "${AC6_XENON}")
    set(xrBuild "${xr}/build")
    if (CMAKE_HOST_WIN32)
        set(exe "${xrBuild}/XenonRecomp/XenonRecomp.exe")
    else()
        set(exe "${xrBuild}/XenonRecomp/XenonRecomp")
    endif()
    # Configured once, built before every recompile (up to date in a moment when nothing changed, so a change to
    # XenonRecomp's sources is in the tool that runs).
    if (NOT EXISTS "${xrBuild}/CMakeCache.txt")
        set(args -S "${xr}" -B "${xrBuild}" -G "${CMAKE_GENERATOR}" -DCMAKE_BUILD_TYPE=Release "-DCMAKE_CXX_FLAGS=-include cstdlib")
        if (CMAKE_TOOLCHAIN_FILE)
            list(APPEND args "-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}")
        else()
            list(APPEND args "-DCMAKE_C_COMPILER=${CMAKE_C_COMPILER}" "-DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}")
        endif()
        if (CMAKE_MAKE_PROGRAM)
            list(APPEND args "-DCMAKE_MAKE_PROGRAM=${CMAKE_MAKE_PROGRAM}")
        endif()
        execute_process(COMMAND "${CMAKE_COMMAND}" ${args} RESULT_VARIABLE r)
        if (NOT r EQUAL 0)
            message(FATAL_ERROR "Configuring XenonRecomp failed")
        endif()
    endif()
    message(STATUS "Building XenonRecomp")
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${xrBuild}" --target XenonRecomp RESULT_VARIABLE r)
    if (NOT r EQUAL 0)
        message(FATAL_ERROR "Building XenonRecomp failed")
    endif()

    message(STATUS "Recompiling the game's code from ${AC6_XEX} (a few minutes)")
    file(REMOVE_RECURSE "${AC6_PPC}")
    file(MAKE_DIRECTORY "${AC6_PPC}")
    execute_process(COMMAND "${exe}" "${AC6_LIB_ROOT}/config/AC6.toml" "${xr}/XenonUtils/ppc_context.h"
        WORKING_DIRECTORY "${AC6_LIB_ROOT}" RESULT_VARIABLE r OUTPUT_FILE "${CMAKE_BINARY_DIR}/recompile_log.txt"
        ERROR_FILE "${CMAKE_BINARY_DIR}/recompile_log.txt")
    if (NOT r EQUAL 0 OR NOT EXISTS "${AC6_PPC}/ppc_recomp_shared.h")
        message(FATAL_ERROR "XenonRecomp failed (${CMAKE_BINARY_DIR}/recompile_log.txt): is default.xex the release this port was made from?")
    endif()
    file(WRITE "${keyFile}" "${key}")
endfunction()

if (AC6_RECOMPILE)
    ac6_recompile()
endif()

# Weak trace stubs for every kernel / XAM import the recompiled code calls.
# Reads GracemeriaRecompLib/ppc/ppc_recomp_shared.h (PPC_EXTERN_FUNC(__imp__Name) declarations that aren't game
# functions) and writes the stubs. Every stub is weak, so a real implementation (a strong definition anywhere in the runtime) replaces it at link
# time. Stubs log the call (kernel/trace.cpp) and return 0 in r3.
#   cmake -DSHARED=<ppc_recomp_shared.h> -DOUTPUT=<cpp> -P gen_imports.cmake
file(READ "${SHARED}" text)
# (The declarations' ";" left out of the match: CMake lists are ";"-separated.)
string(REGEX MATCHALL "PPC_EXTERN_FUNC\\(__imp__[A-Za-z0-9_]+\\)" decls "${text}")
set(names "")
foreach (d ${decls})
    string(REGEX REPLACE "PPC_EXTERN_FUNC\\(__imp__([A-Za-z0-9_]+)\\)" "\\1" n "${d}")
    if (NOT n MATCHES "^sub_")
        list(APPEND names "${n}")
    endif()
endforeach()
list(REMOVE_DUPLICATES names)
list(SORT names)
list(LENGTH names count)

set(out "// Generated by tools/cmake/gen_imports.cmake from GracemeriaRecompLib/ppc/ppc_recomp_shared.h. Do not edit.\n")
string(APPEND out "// Weak trace stubs for every import; strong definitions elsewhere in the runtime replace them.\n")
string(APPEND out "#include \"kernel/trace.h\"\n\nnamespace ac6::kernel {\nconst char* const kImportNames[] = {\n")
foreach (n ${names})
    string(APPEND out "    \"${n}\",\n")
endforeach()
string(APPEND out "};\nconst size_t kImportCount = ${count};\n}\n\n")
set(i 0)
foreach (n ${names})
    string(APPEND out "AC6_IMPORT_STUB(${n}, ${i})\n")
    math(EXPR i "${i} + 1")
endforeach()
# Written only when it changes (the runtime isn't rebuilt for nothing), with LF line ends on every system.
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${out}" @ONLY NEWLINE_STYLE UNIX)

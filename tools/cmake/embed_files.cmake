# Embeds files as byte arrays (the settings overlay's fonts, the shipped pipeline list): a C++ source defining, for
# each, a 4-byte aligned array and its size, and a lookup by name. A file's path is DIR's, unless it is absolute.
#   cmake -DOUTPUT=<cpp> -DDIR=<directory> -DFILES=<name=file|name=file> -P embed_files.cmake
string(REPLACE "|" ";" FILES "${FILES}")
set(BLOBS "")
set(TABLE "")
foreach(entry ${FILES})
    string(FIND "${entry}" "=" eq)
    string(SUBSTRING "${entry}" 0 ${eq} name)
    math(EXPR start "${eq} + 1")
    string(SUBSTRING "${entry}" ${start} -1 path)
    if (NOT IS_ABSOLUTE "${path}")
        set(path "${DIR}/${path}")
    endif()
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(APPEND BLOBS "alignas(4) const unsigned char k_${name}[] = { ${bytes} };\n")
    string(APPEND TABLE "    { \"${name}\", k_${name}, sizeof(k_${name}) },\n")
endforeach()
file(WRITE "${OUTPUT}" "// Generated by tools/cmake/embed_files.cmake.\n#include <cstddef>\n#include <cstring>\n${BLOBS}\n"
    "struct EmbeddedFile { const char* name; const unsigned char* data; size_t size; };\n"
    "static const EmbeddedFile kEmbedded[] = {\n${TABLE}};\n"
    "const unsigned char* EmbeddedFileData(const char* name, size_t* size)\n{\n"
    "    for (const EmbeddedFile& f : kEmbedded)\n        if (std::strcmp(f.name, name) == 0)\n        {\n"
    "            *size = f.size;\n            return f.data;\n        }\n    *size = 0;\n    return nullptr;\n}\n")

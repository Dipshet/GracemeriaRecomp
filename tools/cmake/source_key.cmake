# Writes a C++ constant holding a hash of the given source files:
#   cmake -DOUTPUT=... -DSYMBOL=... -DFILES="a;b;c" -P source_key.cmake
# The shader cache keys its entries with it, so changing the translator invalidates them.
set(ALL "")
foreach(f ${FILES})
    file(SHA1 "${f}" h)
    string(APPEND ALL "${h}")
endforeach()
string(SHA1 KEY "${ALL}")
string(SUBSTRING "${KEY}" 0 16 KEY)
file(WRITE "${OUTPUT}" "// Generated by tools/cmake/source_key.cmake. Do not edit.\n#include <cstdint>\nnamespace ac6::gpu {\nextern const uint64_t ${SYMBOL} = 0x${KEY}ull;\n}\n")
